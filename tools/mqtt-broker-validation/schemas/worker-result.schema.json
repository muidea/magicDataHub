{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker-result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_binding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "sha256",
            "family",
            "mode",
            "configuration_status",
            "config_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "family": {
              "const": "mqtt311-tcp-anonymous-memory"
            },
            "mode": {
              "enum": [
                "owned-instance",
                "live-network-only"
              ]
            },
            "configuration_status": {
              "enum": [
                "snapshot-checked",
                "controlled-reference",
                "unverified"
              ]
            },
            "config_sha256": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "ERROR"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "evidence": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.jsonl$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_bytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "target",
    "case_id",
    "profile_binding",
    "status",
    "error",
    "seconds",
    "evidence",
    "evidence_sha256",
    "evidence_bytes"
  ],
  "additionalProperties": false
}
