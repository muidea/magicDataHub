{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run manifest v1; immutable execution identity plus progress flags",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"
    },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?\\+00:00$"
    },
    "completed_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?\\+00:00$"
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "worker_python": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "profile": {
      "const": "mqtt311-tcp-anonymous-memory"
    },
    "target_profiles": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Target profile evidence binding v1",
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256",
              "family",
              "mode",
              "configuration_status",
              "config_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "family": {
                "const": "mqtt311-tcp-anonymous-memory"
              },
              "mode": {
                "enum": [
                  "owned-instance",
                  "live-network-only"
                ]
              },
              "configuration_status": {
                "enum": [
                  "snapshot-checked",
                  "controlled-reference",
                  "unverified"
                ]
              },
              "config_sha256": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "input_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "upstream_path": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "paho_version": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "host_project": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "configs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "effective_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "source_sha256",
                  "effective_sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "revision",
            "dirty_paths",
            "configs"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requested": {
            "type": "string",
            "pattern": "^(?:sha256:[0-9a-f]{64}|[a-zA-Z0-9./_:-]+@sha256:[0-9a-f]{64})$"
          },
          "actual_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "requested",
          "actual_id"
        ],
        "additionalProperties": false
      }
    },
    "live_endpoints": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "const": "127.0.0.1"
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "required_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:tool|reference|mqtt-server|datahub-server|live-[a-zA-Z0-9][a-zA-Z0-9_-]{0,40})$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "case_timeout_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600
    },
    "cleanup_grace_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 180
    },
    "require_conformance": {
      "type": "boolean"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^(?:tool|reference|mqtt-server|datahub-server|live-[a-zA-Z0-9][a-zA-Z0-9_-]{0,40})$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "required": [
          "target",
          "case_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interrupted": {
      "type": "boolean"
    },
    "cleanup_incomplete": {
      "type": "boolean"
    },
    "input_changed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "python_version",
    "worker_python",
    "profile",
    "target_profiles",
    "source_files",
    "input_files",
    "catalog_sha256",
    "lock_sha256",
    "dependencies_sha256",
    "upstream_commit",
    "upstream_path",
    "paho_version",
    "host_project",
    "images",
    "live_endpoints",
    "required_targets",
    "case_timeout_seconds",
    "cleanup_grace_seconds",
    "require_conformance",
    "plan",
    "plan_sha256",
    "execution_sha256",
    "interrupted",
    "cleanup_incomplete",
    "input_changed"
  ],
  "additionalProperties": false
}
