          "condition": {"type": ["string", "null"]},
          "exclusion_rationale": {"type": ["string", "null"]},
          "required_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
