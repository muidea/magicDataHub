          "parameter_rationale": {"type": "string", "minLength": 1},
          "remaining_gaps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_claim": {"const": "TargetedEvidenceOnly"},
          "review_status": {"const": "pending"}
        },
        "required": [
          "parent_id", "key", "normative_level", "applicability", "case_ids",
          "required_assertions", "captured_wire_checks", "required_event_kinds",
          "parent_verifier", "positive_oracles", "negative_counterexamples",
          "allowed_variants", "parameter_rationale", "remaining_gaps",
          "evidence_claim", "review_status"
        ],
        "additionalProperties": false
      }
    },
    "mixed_qos_draft_oracles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
