{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle, applicability, SHOULD deviation and sufficiency ledger; never independent approval",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "independent_approvals": {
      "const": 0
    },
    "review_status": {
      "const": "pending"
    },
    "runtime_results": {
      "const": "not-produced-by-ledger"
    },
    "full_conformance": {
      "const": "Partial"
    },
    "selected_id_oracles": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MQTT-[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+$"
          },
          "normative_level": {
            "enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT"]
          },
          "applicability": {
            "enum": ["required", "conditional", "excluded"]
          },
          "condition": {
            "type": ["string", "null"]
          },
          "exclusion_rationale": {
            "type": ["string", "null"]
          },
          "should_deviation": {
            "type": ["string", "null"]
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "alternative_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "required_assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "captured_wire_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "required_event_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "parent_verifier": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "positive_oracles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "negative_counterexamples": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "allowed_variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "parameter_rationale": {
            "type": "string",
            "minLength": 1
          },
          "remaining_gaps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_claim": {
            "const": "TargetedEvidenceOnly"
          },
          "review_status": {
            "const": "pending"
          }
        },
        "required": [
          "id", "normative_level", "applicability", "condition", "exclusion_rationale",
          "should_deviation", "case_ids", "alternative_groups", "required_assertions",
          "captured_wire_checks", "required_event_kinds", "parent_verifier",
          "positive_oracles", "negative_counterexamples", "allowed_variants",
          "parameter_rationale", "remaining_gaps", "evidence_claim", "review_status"
        ],
        "additionalProperties": false
      }
    },
    "compound_atom_oracles": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
