# Copy to .env and set a strong PostgreSQL password before running `docker compose up -d`.
FEDENGINE_PASSWORD=change-me-please

# Container registry prefix and release version tag
MDH_IMAGE_PREFIX=ghcr.io/muidea
MDH_IMAGE_TAG=v0.1.0

# Bridge port bindings (set MDH_BIND_HOST=127.0.0.1 to restrict to localhost only)
MDH_BIND_HOST=0.0.0.0
MDH_PG_PORT=5432
MDH_HTTP_PORT=8080
MDH_MQTT_PORT=1883
